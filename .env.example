# Facilitator-AI environment template
# Copy to .env for local development. Never commit real secrets.

# Azure OpenAI runtime settings (required for /api/analyze)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=replace-with-chat-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional client proxy URL (if still used by frontend)
VITE_PROXY_URL=https://example-proxy-url

# App runtime
PORT=8080
